PAYMENT_MODE=demo
DATABASE_URL=sqlite:///./servicepromise.db
PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
AUTO_REFUND=false
# Sandbox requires all of the following. Never commit .env.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
OPERATOR_TOKEN=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Enable operator-protected catalogue Sandbox jobs after configuring test credentials.
CATALOG_PAYPAL_SANDBOX_ENABLED=false
